import { useEffect, useMemo } from "react";

import DrillVideoPlayer from "./drills/DrillVideoPlayer";
import { collectDrillMedia } from "../utils/drillVideo";

export default function DrillModal({ open, onClose, drill }) {
  useEffect(() => {
    if (!open) return;
    const onKey = (e) => {
      if (e.key === "Escape") onClose?.();
    };
    window.addEventListener("keydown", onKey);
    return () => window.removeEventListener("keydown", onKey);
  }, [open, onClose]);

  const title = drill?.title || drill?.name || "Упражнение";
  const { images, videoItems } = useMemo(() => collectDrillMedia(drill || {}), [drill]);

  if (!open) return null;

  return (
    <div
      onClick={onClose}
      style={{
        position: "fixed",
        inset: 0,
        background: "rgba(0,0,0,0.55)",
        zIndex: 9999,
        display: "flex",
        alignItems: "center",
        justifyContent: "center",
        padding: 16,
      }}
    >
      <div
        onClick={(e) => e.stopPropagation()}
        style={{
          width: "min(980px, 100%)",
          maxHeight: "88vh",
          overflow: "auto",
          background: "white",
          borderRadius: 14,
          boxShadow: "0 18px 60px rgba(0,0,0,0.35)",
          border: "1px solid rgba(0,0,0,0.08)",
        }}
      >
        <div
          style={{
            display: "flex",
            gap: 12,
            alignItems: "center",
            justifyContent: "space-between",
            padding: "14px 16px",
            borderBottom: "1px solid #eee",
            position: "sticky",
            top: 0,
            background: "white",
            zIndex: 1,
          }}
        >
          <div style={{ minWidth: 0 }}>
            <div style={{ fontSize: 18, fontWeight: 800, lineHeight: 1.2, overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>
              {title}
            </div>
            <div style={{ fontSize: 12, color: "#666", marginTop: 4 }}>
              ID: {drill?.id ?? "—"} • Категория: {drill?.category || "—"} • Ниво: {drill?.level || "—"} • Оборудване: {drill?.equipment || "—"}
            </div>
          </div>

          <button
            type="button"
            onClick={onClose}
            style={{
              border: "1px solid #ddd",
              background: "white",
              borderRadius: 10,
              padding: "8px 10px",
              cursor: "pointer",
              fontWeight: 700,
            }}
          >
            ✕ Затвори
          </button>
        </div>

        <div style={{ padding: 16 }}>
          {drill?.description ? (
            <div style={{ marginBottom: 16 }}>
              <div style={{ fontWeight: 800, marginBottom: 6 }}>Описание</div>
              <div style={{ whiteSpace: "pre-wrap", lineHeight: 1.5 }}>{drill.description}</div>
            </div>
          ) : null}

          {images.length > 0 ? (
            <div style={{ marginBottom: 18 }}>
              <div style={{ fontWeight: 800, marginBottom: 10 }}>Снимки</div>
              <div style={{ display: "flex", gap: 12, flexWrap: "wrap" }}>
                {images.map((url) => (
                  <a
                    key={url}
                    href={url}
                    target="_blank"
                    rel="noreferrer"
                    style={{
                      display: "block",
                      borderRadius: 12,
                      overflow: "hidden",
                      border: "1px solid #e6e6e6",
                      boxShadow: "0 10px 24px rgba(0,0,0,0.08)",
                    }}
                    title="Отвори в нов прозорец"
                  >
                    <img
                      src={url}
                      alt="drill"
                      style={{ width: 260, height: 160, objectFit: "cover", display: "block" }}
                      onError={(e) => {
                        e.currentTarget.style.display = "none";
                      }}
                    />
                  </a>
                ))}
              </div>
            </div>
          ) : null}

          {videoItems.length > 0 ? (
            <div style={{ marginBottom: 10 }}>
              <div style={{ fontWeight: 800, marginBottom: 10 }}>Видео</div>
              <div style={{ display: "grid", gap: 14 }}>
                {videoItems.map((v) => (
                  <div key={v.original} style={{ border: "1px solid #e6e6e6", borderRadius: 12, padding: 10 }}>
                    <DrillVideoPlayer url={v.original} />
                    <div style={{ marginTop: 8, fontSize: 12, color: "#64748b" }}>{v.label}</div>
                  </div>
                ))}
              </div>
            </div>
          ) : null}

          {!drill?.description && images.length === 0 && videoItems.length === 0 ? (
            <div style={{ background: "#f7f7f7", border: "1px solid #eee", padding: 12, borderRadius: 12 }}>
              Няма добавена медия/описание за това упражнение.
            </div>
          ) : null}
        </div>
      </div>
    </div>
  );
}
